#!/usr/bin/env python3
"""Doctor CLI - Analyze lab data via Ollama LLM."""
import sys
from ollama_client import OllamaClient


def main():
    """Main entry point - reads JSON from stdin, sends to Ollama."""
    data = sys.stdin.read()
    
    prompt = f"""You are Doctor, a medical AI assistant.

Your task: Analyze the laboratory test results below and provide a comprehensive clinical interpretation.
The results may be from a chemistry panel, liver function tests, kidney function, etc.

For each test:
- Report whether the value is within normal reference range
- Flag abnormalities (high/low)
- Provide clinical interpretation
- Suggest next steps if needed

Output format:
- Clear clinical summary
- List of abnormal values
- Overall assessment
- Recommendations
- **IMPORTANT: Respond in RUSSIAN (русский язык)**

LAB DATA:
---
{data}
"""
    
    response = OllamaClient().generate(prompt)
    print(response)
    return 0


if __name__ == "__main__":
    sys.exit(main())